<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.local.waylith.port"
    android:versionCode="1"
    android:versionName="0.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The import of the player's game (the tester's APK) and the game itself keep their processes alive as foreground
         services (ImportService, GameService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="false" />
    <!-- The system's Files app, which FilesProvider.folderIntent opens at the game's folders: since Android 11 an app sees
         another only when it names here what it looks for (the document chooser, what shows a folder). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
    </queries>
    <!-- appCategory/isGame: the system (and the maker's game mode on top of it) schedules and cools a declared game as one. -->
    <!-- gwpAsanMode: the system's sampling memory checker for the native heap (Android 11 and later), every launch. A
         native write past an allocation, a use after free or a double free of a sampled allocation stops the game at
         once, and the tombstone names where it was allocated and freed (Diagnostics puts that in the crash report).
         A tester, 2026-10-27: "Scudo ERROR: corrupted chunk header", found only at a later free of a dead thread's
         record, by whom it was overwritten unknown. A few percent of memory, no measurable speed. -->
    <!-- hasFragileUserData: the saves, Config, mods and the game's files live in the app's own folders, which an
         uninstall deletes; with it the system's uninstall dialog (Android 10 and later) offers to keep them, and a
         reinstall finds them again. On the PC they stay in AppData when the game is uninstalled. The box starts
         unticked. A reinstall must be signed with the same key (port17.keystore) while kept data is there. -->
    <application android:allowNativeHeapPointerTagging="false"
        android:gwpAsanMode="always"
        android:appCategory="game"
        android:isGame="true"
        android:label="Port17"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:largeHeap="true">
        <activity
            android:name="com.local.waylith.port.MainActivity"
            android:label="Port17"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|keyboard|screenLayout|uiMode|density|fontScale|fontWeightAdjustment|navigation|touchscreen|layoutDirection|colorMode|locale|mcc|mnc">
            <meta-data android:name="android.app.lib_name" android:value="porthost" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- "导出日志" on the launcher icon (a dynamic shortcut, Diagnostics.java): packs the logs into Download/Port17. -->
        <activity
            android:name="com.local.waylith.port.ExportLogsActivity"
            android:label="导出日志"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The tester's APK: "重新导入游戏" on the launcher icon (ReimportActivity.java): take the game from another copy. -->
        <activity
            android:name="com.local.waylith.port.ReimportActivity"
            android:label="重新导入游戏"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The tester's APK: makes the player's own copy of the game ready (setup/PortSetup.dll) in a process of its own. -->
        <service android:name="com.local.waylith.port.SetupService" android:process=":setup" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name="com.local.waylith.port.ImportService" android:exported="false" android:foregroundServiceType="dataSync" />
        <!-- Keeps the game from being ended in the background while the player looks at another app (GameService.java). -->
        <service android:name="com.local.waylith.port.GameService" android:exported="false" android:foregroundServiceType="dataSync" />
        <!-- The game's data folder and its Mods as places in the system's Files app and in every app's file chooser
             (FilesProvider.java), as Explorer shows them on the PC. Only the system's documents UI may ask it
             (MANAGE_DOCUMENTS), other apps only for what the player picked for them. A process of its own: a restart or a
             crash of the game loses no write and ends no app that has a file of it open. host/build.sh gives a
             TEST_PACKAGE build its own authority. -->
        <provider
            android:name="com.local.waylith.port.FilesProvider"
            android:authorities="com.local.waylith.port.files"
            android:process=":files"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
